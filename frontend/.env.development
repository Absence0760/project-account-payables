# Backend API URL — override per environment
# Dev:  http://localhost:8000
# QA:   https://api-qa.feohledger.com
# Prod: https://api.feohledger.com
PUBLIC_API_URL=http://localhost:8000

# Registrable domains the PLATFORM itself serves, comma-separated. A host under
# one of these carries the tenant slug as its first label (`acme.localhost` →
# `acme`); a bare one is the marketing/signup host. ANY OTHER host is treated as
# a customer's white-label vanity domain: the SPA sends no `X-Tenant-Slug` and
# calls `/api` same-origin, so the backend resolves the tenant from the `Host`
# header (`settings.brand.custom_domains`). See docs/white-label.md § Custom
# domains.
#
# `localhost` keeps `acme.localhost:7777` / `techflow.localhost:7777` resolving
# exactly as before. Deployed builds set this to their own apex, e.g.
# PUBLIC_PLATFORM_DOMAINS=feohledger.com
#
# Leaving it UNSET is legal and means "the pre-vanity-domain rule" (first label
# of any 3+-label host), so an existing build that sets only PUBLIC_API_URL is
# unchanged.
PUBLIC_PLATFORM_DOMAINS=localhost
