{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "FTF",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=tests-e2e/playwright.config.ts --ui",
		"test:e2e:a11y": "playwright test --config=tests-e2e/playwright.config.ts tests-e2e/a11y"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@iconify-json/material-symbols": "1.2.87",
		"@playwright/test": "1.62.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"axe-core": "^4.12.1",
		"mdsvex": "^0.12.8",
		"normalize.css": "8.0.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.3",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "8.1.5",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"dependencies": {
		"isomorphic-dompurify": "^3.19.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": ">=0.7.0 <0.8.0",
			"undici@<7.28.0": ">=7.28.0"
		}
	}
}
