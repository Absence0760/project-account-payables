{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "feohledger-frontend",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"//": "`prepare` runs automatically after `pnpm install`. svelte-kit sync generates .svelte-kit/tsconfig.json, which the checked-in tsconfig.json extends — so ANY TypeScript transform needs it, vitest included. It used to appear only as a prefix on `check`, leaving `test:unit` with an undeclared dependency on some other script having run first: a fresh clone (or a CI job that runs the tests before the typecheck) failed with 21 files at TSCONFIG_ERROR and zero tests executed. Declaring it here makes the ordering irrelevant.",
		"prepare": "svelte-kit sync",
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=tests-e2e/playwright.config.ts --ui",
		"test:e2e:a11y": "playwright test --config=tests-e2e/playwright.config.ts tests-e2e/a11y"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@iconify-json/material-symbols": "1.2.89",
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"axe-core": "^4.13.0",
		"mdsvex": "^0.12.8",
		"normalize.css": "8.0.1",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "8.2.2",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"isomorphic-dompurify": "^3.22.0"
	},
	"pnpm": {
		"overrides": {
			"cookie@<0.7.0": ">=0.7.0 <0.8.0",
			"undici@<7.28.0": ">=7.28.0"
		}
	}
}
