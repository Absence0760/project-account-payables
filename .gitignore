# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Plaintext terraform.tfvars is secret; the SOPS-encrypted
# terraform.tfvars.sops is committed. Example is a template, safe to commit.
# Keep .terraform.lock.hcl committed — it pins provider versions.
*.tfvars
!*.tfvars.example
!*.tfvars.sops

# ---------------------------------------------------------------------------
# Local agent / AI tooling state
# ---------------------------------------------------------------------------
# .claude/agents/ and .claude/commands/ ARE checked in — the agents and
# slash commands are part of the repo's review surface and should be
# shared across contributors. Only ignore the per-user / runtime bits.
.claude/settings.local.json
.claude/*.lock

# ---------------------------------------------------------------------------
# Playwright
# ---------------------------------------------------------------------------
# Playwright resolves output dirs relative to the runner's cwd
# (frontend/), not testDir (frontend/tests-e2e/). The .auth/ storage
# state lives next to the config — never commit; it holds live session
# cookies.
frontend/tests-e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ---------------------------------------------------------------------------
# Persona audit reports
# ---------------------------------------------------------------------------
# `.claude/agents/persona-*.md` auditors write their findings here. The
# reports are working notes (per-clone, often half-reconciled), never a
# committed artifact — but the folder's README documents the convention,
# so keep that one file tracked via the negation below. Glob the contents
# (`/reviews/*`), not the directory (`/reviews/`) — git won't descend into an
# ignored directory, so a directory-level ignore would defeat the negation.
/reviews/*
!/reviews/README.md

# ---------------------------------------------------------------------------
# IDE / editor / OS scratch files
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store