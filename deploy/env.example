# Template for the production env — the contract for deploy/.env.sops.
# Author a copy of this file with real values, encrypt it with sops into the
# PRIVATE infra-secrets repo (per-project subdir + KMS key), and copy the
# encrypted result onto the VM as deploy/.env.sops. deploy.sh decrypts it to
# deploy/.env (gitignored) on every run. NEVER commit a plaintext copy with
# real values, and never commit the .sops file to this (public) repo.
#
# Full context: docs/minimal-deployment.md. The app's complete FEOH_* reference
# is docs/environment.md — everything not listed here keeps its safe default
# (mock adapters, local dispatch modes, background sweeps off).

# ── Deploy-level (consumed by compose interpolation + deploy.sh + backup.sh) ──
# URL-safe by construction: openssl rand -hex 24 (it is embedded in the DSN).
POSTGRES_PASSWORD=
# Bare SPA host, API host, and the ACME registration email.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
# Region for boto3 (S3 / SES) inside the api container.
AWS_REGION=us-east-1
# Versioned bucket the nightly backup.sh streams pg dumps into.
BACKUP_S3_BUCKET=

# ── Core app config ──
FEOH_ENVIRONMENT=production
# openssl rand -hex 32
FEOH_SECRET_KEY=
# FEOH_DATABASE_URL / FEOH_REDIS_URL default to the local containers (derived in
# compose.prod.yml). Setting either here overrides the default — this is the
# entire migration path to RDS / ElastiCache later, no compose edit needed.
#FEOH_DATABASE_URL=postgresql+asyncpg://user:pass@your-rds-host:5432/account_payables
#FEOH_REDIS_URL=redis://your-elasticache-host:6379

# ── S3 (real AWS — empty endpoint/keys = instance-profile credentials) ──
FEOH_S3_BUCKET=
FEOH_S3_ENDPOINT_URL=
FEOH_S3_ACCESS_KEY=
FEOH_S3_SECRET_KEY=

# ── URLs (drive emails, SAML SP entity, tenant links, CORS) ──
FEOH_PUBLIC_URL=https://app.example.com
FEOH_API_PUBLIC_URL=https://api.example.com
FEOH_TENANT_URL_TEMPLATE=https://{slug}.app.example.com
FEOH_CORS_PRODUCTION_DOMAIN=app.example.com

# ── Deployed-env posture ──
FEOH_MFA_ENABLED=true
FEOH_HSTS_ENABLED=true

# ── Email (SES sandbox only sends to verified recipients — request
#    production access, or keep provider=console until it clears) ──
FEOH_EMAIL_PROVIDER=ses
FEOH_EMAIL_FROM=no-reply@example.com
FEOH_AWS_SES_REGION=us-east-1

# ── Signing keys (each key's presence is its feature's on-switch; leave a
#    key unset to keep that feature off) — openssl rand -hex 32 each ──
FEOH_APPROVAL_SIGNING_KEY=
#FEOH_EMAIL_ACTION_SIGNING_KEY=
#FEOH_PARTNER_LINK_SIGNING_KEY=

# ── Self-service signup (required in production if signup stays enabled;
#    FEOH_ENVIRONMENT=production refuses to boot with an empty captcha secret) ──
FEOH_HCAPTCHA_SECRET=
FEOH_HCAPTCHA_SITEKEY=
