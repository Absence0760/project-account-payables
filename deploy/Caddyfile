# Caddy config for the minimal single-VM deployment (docs/minimal-deployment.md).
# Domains come from deploy/.env via the compose service's environment.
# TLS is automatic per-host HTTP-01 — every hostname listed here (and in
# tenants.caddy) gets its own Let's Encrypt certificate, so each must resolve
# to this VM before Caddy can issue for it. Recommended: one wildcard DNS
# record (*.<APP_DOMAIN> → this VM) so new tenants need no DNS work at all —
# a DNS wildcard needs no wildcard *certificate*; per-host HTTP-01 still
# issues fine for each listed host.

{
	email {$ACME_EMAIL}
}

# The static SvelteKit SPA. try_files matches adapter-static's
# fallback: "index.html" — deep links rehydrate client-side.
(spa) {
	root * /srv
	encode zstd gzip
	# Tablestakes security headers for the static SPA. The API host doesn't
	# need them here — the backend middleware (app/main.py) sets its own on
	# every response. No CSP: SvelteKit's hydration uses inline scripts.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	try_files {path} /index.html
	file_server
}

# Bare app host — login / signup / marketing surface.
{$APP_DOMAIN} {
	import spa
}

# Backend API. The frontend is built with PUBLIC_API_URL=https://{$API_DOMAIN};
# CORS for the tenant subdomains is the backend's job (FEOH_CORS_PRODUCTION_DOMAIN).
{$API_DOMAIN} {
	reverse_proxy api:8000
}

# One site block per tenant subdomain lives in the per-VM tenants.caddy
# (gitignored — seeded from tenants.caddy.example by deploy.sh).
import tenants.caddy
