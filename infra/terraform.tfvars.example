# Copy this file to terraform.tfvars and fill in the values, OR use SOPS:
#   cp terraform.tfvars.example terraform.tfvars
#   # edit values...
#   sops -e terraform.tfvars > terraform.tfvars.sops && rm terraform.tfvars
#
# Plaintext terraform.tfvars is gitignored. The encrypted terraform.tfvars.sops
# is what gets committed. See .sops.yaml and backend/CLAUDE.md § Secrets
# management.

# Primary AWS region.
aws_region = "us-east-1"

# Project name used for tagging and resource naming.
project = "account-payables"

# Environment (prod, staging, etc.). Becomes part of resource names + tags.
environment = "prod"

# --- S3 bucket names --------------------------------------------------------
# Globally unique. Include a short random suffix so re-creation doesn't
# conflict with the bucket name's 30-day cooldown (AWS keeps deleted bucket
# names reserved briefly to prevent takeover).
invoice_files_bucket_name = "account-payables-invoices-prod-REPLACE"
audit_logs_bucket_name    = "account-payables-audit-logs-prod-REPLACE"

# --- Object Lock retention --------------------------------------------------
# Days an object stays locked after it lands. Invoices run in Governance mode
# (legitimate override possible); audit logs run in Compliance mode (no
# override even with root). Defaults match SOC 2 expectations — override if
# your data-retention policy calls for a different number.
# invoice_retention_days = 365
# audit_retention_days   = 2555

# --- Placeholders for future real resources ---
#
# When the ECS/ALB/RDS/CloudFront stack lands, put its secrets here:
#   - rds_master_password
#   - anthropic_api_key
#   - lithic_api_key / nium_client_secret
#   - github_repo (for OIDC role trust policy)
#   - domain_name / route53_zone_id
#
# Mirror the FEOH_* env vars in backend/.env.example — anything in there that
# is a real secret belongs in this file once deployed to AWS.
