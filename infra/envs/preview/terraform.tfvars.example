# Copy to terraform.tfvars (gitignored) and fill in.
#
# operator_role_arns lists every IAM principal that should be able to
# encrypt / decrypt the preview sops file. At minimum, include:
#   - the preview deploy role ARN (from infra/github-oidc outputs)
#   - any human IAM Identity Center role(s) that need to edit secrets
# The account root is added automatically by the module — no need to
# list it here.

# operator_role_arns = [
#   "arn:aws:iam::123456789012:role/ap-deploy-preview",
#   "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxxxxxx",
# ]
