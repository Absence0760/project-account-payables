{
  "realm": "account-payables",
  "enabled": true,
  "displayName": "Account Payables (local dev IdP)",
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "account-payables-app",
      "name": "Account Payables (local dev)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-keycloak-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:7777/login/sso-callback",
        "http://acme.localhost:7777/login/sso-callback",
        "http://techflow.localhost:7777/login/sso-callback",
        "http://e2e1.localhost:7777/login/sso-callback",
        "http://e2e2.localhost:7777/login/sso-callback",
        "http://e2e3.localhost:7777/login/sso-callback",
        "http://e2e4.localhost:7777/login/sso-callback",
        "http://e2e5.localhost:7777/login/sso-callback",
        "http://e2e6.localhost:7777/login/sso-callback",
        "http://e2e7.localhost:7777/login/sso-callback",
        "http://e2e8.localhost:7777/login/sso-callback"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["openid", "email", "profile", "roles", "web-origins"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "http://localhost:8000/api/auth/saml/metadata",
      "name": "Account Payables SAML (local dev)",
      "description": "Shared local SAML SP. One client serves every tenant; the backend recovers the tenant from the server-minted RelayState (not the assertion), so the SP entityId + ACS are shared. See docs/local-sso-saml.md.",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:8000/api/auth/saml/acs"],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.authnstatement": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:8000/api/auth/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        },
        {
          "name": "givenName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "givenName",
            "attribute.nameformat": "Basic",
            "friendly.name": "givenName"
          }
        },
        {
          "name": "surname",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "attribute.name": "sn",
            "attribute.nameformat": "Basic",
            "friendly.name": "sn"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo@acme.com",
      "email": "demo@acme.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ]
    },
    {
      "username": "newhire@acme.com",
      "email": "newhire@acme.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Nat",
      "lastName": "Newhire",
      "credentials": [
        { "type": "password", "value": "demo", "temporary": false }
      ]
    }
  ]
}
