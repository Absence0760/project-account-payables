AP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/account_payables
AP_SECRET_KEY=change-me-in-production
AP_S3_ENDPOINT_URL=http://localhost:9000
AP_S3_ACCESS_KEY=minioadmin
AP_S3_SECRET_KEY=minioadmin
AP_S3_BUCKET=invoices
AP_DEBUG=true

# --- Local AWS emulator (LocalStack) — optional, see docs/local-aws-localstack.md ---
# Empty = real AWS (prod default). Uncomment + `pnpm aws:up` to route SQS (lambda
# dispatch), SES email, and CloudWatch/S3-ObjectLock audit shipping at LocalStack.
# AP_AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1
# AP_SQS_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/ap-extraction
# AP_SQS_ERP_QUEUE_URL=http://localhost:4566/000000000000/ap-erp
# AP_SQS_AUDIT_QUEUE_URL=http://localhost:4566/000000000000/ap-audit
# AP_AUDIT_SHIPPING_S3_BUCKET=ap-audit-worm
# AP_AUDIT_SHIPPING_CLOUDWATCH_GROUP=/ap/audit

# Self-service signup
# AP_EMAIL_PROVIDER: "console" logs to stdout (local default); "smtp" sends over
# SMTP (point at Mailpit locally); "ses" sends via AWS SES.
AP_EMAIL_PROVIDER=console
AP_EMAIL_FROM=no-reply@localhost
AP_AWS_SES_REGION=us-east-1
# Local email inbox via Mailpit — `pnpm mail:up`, then set provider to smtp and
# view rendered mail at http://localhost:8025. See docs/local-email-mailpit.md.
# AP_EMAIL_PROVIDER=smtp
# AP_SMTP_HOST=localhost
# AP_SMTP_PORT=1025
# AP_SMTP_USE_TLS=false

# Email + in-app notifications on invoice events (assigned/approved/rejected/
# paid). Defaults on; sends via AP_EMAIL_PROVIDER above (console locally).
# Set to false to silence all notifications. See docs/notifications.md.
AP_NOTIFICATIONS_ENABLED=true

# Public URL where the frontend is served. Used to build verification links
# in outbound emails.
AP_PUBLIC_URL=http://localhost:7777

# Template for the per-tenant URL in the welcome email. {slug} is substituted.
AP_TENANT_URL_TEMPLATE=http://{slug}.localhost:7777

# hCaptcha keys — leave the secret empty locally to skip verification.
# Get real values from https://dashboard.hcaptcha.com.
AP_HCAPTCHA_SECRET=
AP_HCAPTCHA_SITEKEY=

# Redis-backed rate limiter master switch. Default true in production.
# Disabled in local dev so the e2e suite (multiple sign-ins per spec from the
# same loopback IP) doesn't saturate the /api/auth/login 10/min cap — the CI
# workflow also sets this to false for the same reason (see .github/workflows/
# ci.yml). Flip to true to test rate-limiting behaviour locally.
AP_RATE_LIMIT_ENABLED=false

# Max concurrent sessions per user before the oldest JTI is evicted (revoked).
# Default 5 in production. The e2e suite signs the same per-role user in many
# times across specs, so a full local run blows past 5 and older tokens start
# returning 401 "Token has been revoked". CI raises this to 100 for the same
# reason (see .github/workflows/ci.yml); match it locally. 0 disables the cap.
AP_MAX_CONCURRENT_SESSIONS=100

# Max signups per IP per hour (Redis-backed sliding window).
AP_SIGNUP_RATE_LIMIT_PER_HOUR=5

# RAG / embeddings
# AP_EMBEDDING_PROVIDER: "mock" (local dev, deterministic hash-to-vector)
#                       or "openai" (text-embedding-3-small via OpenAI API)
AP_RAG_ENABLED=true
AP_RAG_TOP_K=3
AP_EMBEDDING_PROVIDER=mock
AP_EMBEDDING_API_KEY=
AP_EMBEDDING_MODEL=text-embedding-3-small
AP_EMBEDDING_DIMENSIONS=1536

# Cosine similarity threshold for flagging near-duplicate invoices via RAG
# embeddings. 0.95 is tight enough that recurring monthly invoices from the
# same vendor don't false-positive, but loose enough to catch OCR drift.
AP_DUPLICATE_SIMILARITY_THRESHOLD=0.95

# MFA
# Master kill switch. Default `false` for local dev so you don't need a TOTP
# app to log in. Flip to `true` in any deployed environment.
AP_MFA_ENABLED=false
# Label shown in authenticator apps. Per-tenant context is appended to the
# account label automatically.
AP_MFA_ISSUER="Account Payables"
# Email-OTP lifetime in seconds. Default 6 minutes.
AP_MFA_EMAIL_OTP_TTL_SECONDS=360
# How long the post-password "you still need to MFA" challenge token is valid.
AP_MFA_CHALLENGE_TTL_SECONDS=300

# SSO / SCIM
# Path under each tenant's subdomain that the IdP redirects back to after
# OIDC authentication. Must match the redirect URI registered with Okta/Entra.
AP_SSO_REDIRECT_PATH=/login/sso-callback
# How long an authorize state/nonce is valid in Redis before the user must
# restart the SSO handshake. 600s (10 min) covers slow IdPs without keeping
# stale state hanging around.
AP_SSO_STATE_TTL_SECONDS=600
# Path the SCIM 2.0 endpoints are mounted at. Each tenant's SCIM URL is
# AP_PUBLIC_URL + this path + /Users (e.g. https://app.com/api/scim/v2/Users).
AP_SCIM_URL_PATH=/api/scim/v2

# Conversational AP Assistant (see backend/docs/conversational-assistant.md).
# Local-AI default: the `ollama` adapter drives the assistant against a local,
# tool-capable Ollama text model (AP_ASSISTANT_OLLAMA_MODEL) — no key, no cloud.
# Local-first is preserved: if Ollama isn't running or the model isn't pulled,
# the adapter fails soft to the deterministic `mock` router, so a fresh clone
# still answers with zero dependencies. Set AP_ASSISTANT_PROVIDER=claude (+ a
# real AP_ANTHROPIC_API_KEY) for the hosted model; claude auto-downgrades to
# `mock` when the key is empty. AP_ASSISTANT_MODEL (claude only) empty -> falls
# back to AP_EXTRACTION_MODEL. Budget 0 disables the cap.
# Pull the model once: `ollama pull qwen2.5:7b` (a tool-capable instruct model;
# coder/vision variants either can't tool-call or format answers poorly).
AP_ASSISTANT_PROVIDER=ollama
AP_ASSISTANT_OLLAMA_MODEL=qwen2.5:7b
AP_ASSISTANT_MODEL=
AP_ASSISTANT_MONTHLY_TOKEN_BUDGET=200000
AP_ASSISTANT_MAX_TOOL_HOPS=4

# PEPPOL AS4 inbound receive (see backend/docs/peppol.md § Inbound). The public
# webhook POST /api/peppol/inbound/{tenant_slug} is a no-op 204 until enabled.
# The signing secret below is a NON-secret local dev value (NOT a real secret)
# so the webhook is exercisable under `pnpm dev` with a known key — deployed
# envs set the real secret via sops. The mock PEPPOL adapter (default) parses a
# dev-shaped JSON/header envelope, so no real Access Point credential is needed.
AP_PEPPOL_INBOUND_ENABLED=true
AP_PEPPOL_INBOUND_SIGNING_SECRET=dev-peppol-inbound-secret

# Outbound Developer-API webhooks (see backend/docs/public-api.md § Outbound
# webhooks). Local-dev-only SSRF-guard escape hatch: allow a webhook target to
# resolve to a private/loopback address so the delivery path is exercisable
# against 127.0.0.1 (e.g. a local sink) under `pnpm dev`. The deployed default
# is false (blocking) — loopback / RFC1918 / link-local (incl. 169.254.169.254
# metadata) / unique-local / reserved targets are rejected at subscription
# create/update AND re-checked before every dispatch. Webhooks themselves stay
# OFF locally (AP_WEBHOOKS_ENABLED defaults false), so no outbound call fires.
AP_WEBHOOKS_ALLOW_PRIVATE_TARGETS=true

# Punch-out catalogs (see backend/docs/procurement-catalogs.md). The mock
# adapter (default) runs the whole cXML/OCI round-trip in-process — no supplier.
# The return signing secret below is a NON-secret local dev value (NOT a real
# secret) so the public PunchOutOrderMessage cart-return webhook is exercisable
# under `pnpm dev` with a known key; deployed envs set the real secret via sops.
AP_PUNCHOUT_PROVIDER=mock
AP_PUNCHOUT_RETURN_SIGNING_SECRET=dev-punchout-return-secret

# Digital signatures on approvals (SOX non-repudiation — see
# backend/docs/approval-signatures.md). HMAC-SHA256 key over the canonical
# approval facts, stamped on each `invoice.approved` audit row and re-verified
# via GET /api/audit/invoice/{id}/verify-signatures. The value below is a
# NON-secret local dev value (NOT a real key) so signatures are exercisable
# under `pnpm dev`; deployed envs set the real key via sops. Empty → signing is
# skipped (no hardcoded production fallback).
AP_APPROVAL_SIGNING_KEY=dev-approval-signing-key

# Email approval — approve/reject an assigned invoice from the review-assignment
# email with no login (see backend/docs/email-approval.md). HMAC-SHA256 key that
# signs the single-action token carried in the email link. The value below is a
# NON-secret local dev value (NOT a real key) so the flow is exercisable under
# `pnpm dev` (preview the email in Mailpit via `pnpm mail:up` + AP_EMAIL_PROVIDER
# =smtp); deployed envs set the real key via sops. Empty → the feature is off:
# no links are added and every token is rejected (no hardcoded fallback).
AP_EMAIL_ACTION_SIGNING_KEY=dev-email-action-signing-key
AP_EMAIL_ACTION_TTL_HOURS=168

# Slack interactive approval (approve/reject from the Slack message buttons —
# see backend/docs/slack-approval.md). NON-secret local dev value (NOT a real
# Slack signing secret) so the interactivity webhook is exercisable in tests;
# deployed envs set the real Slack app signing secret via sops. Empty → the
# feature is off: every inbound Slack interactivity POST is rejected (fail-
# closed, no hardcoded fallback). The action token in the button value reuses
# AP_EMAIL_ACTION_SIGNING_KEY above (bound to the `slack` channel).
AP_SLACK_SIGNING_SECRET=dev-slack-signing-secret

# Microsoft Teams interactive approval (approve/reject from the Teams approval
# card — see backend/docs/teams-approval.md). NON-secret local dev value (NOT a
# real Teams Outgoing-Webhook security token) so the interactivity webhook is
# exercisable in tests; deployed envs set the real Teams security token via sops.
# Teams signs the POST as `Authorization: HMAC <base64-hmac-sha256>` over the raw
# body using the base64-DECODED value of this token, so it must be valid base64.
# Empty → the feature is off: every inbound Teams interactivity POST is rejected
# (fail-closed, no hardcoded fallback). The action token in the card action
# reuses AP_EMAIL_ACTION_SIGNING_KEY above (bound to the `teams` channel).
AP_TEAMS_SECURITY_TOKEN=ZGV2LXRlYW1zLXNlY3VyaXR5LXRva2Vu

# Partner / reseller link codes (white-label two-sided-consent attach — see
# docs/white-label.md § Partner / reseller admin). NON-secret local dev value so
# the link-code mint + redeem flow is exercisable under `pnpm dev` / tests;
# deployed envs set the real key via sops. Empty → the feature is off: no link
# code can be minted and every redeem is rejected (fail-closed, no hardcoded
# fallback). The key's presence is the single on/off knob.
AP_PARTNER_LINK_SIGNING_KEY=dev-partner-link-signing-key
AP_PARTNER_LINK_TTL_MINUTES=30

# Retention policies (SOX records management — see backend/docs/retention.md).
# The enforcement sweep is OFF by default in local dev; flip on in deployed
# envs. Per-record-class windows live on Organization.settings.retention and are
# read/updated via GET/PUT /api/retention-policy. The sweep composes with the
# audit-immutability trigger — it NEVER deletes audit_log rows.
AP_RETENTION_ENABLED=false
AP_RETENTION_INTERVAL_SECONDS=86400
AP_RETENTION_DEFAULT_MONTHS=84

# ERP adapter base-URL overrides — point local dev at the fake ERP container
# (backend/docker-compose.yml `fake-erp` service, host port 12112) so the three
# real adapters (merge_dev / netsuite / dynamics_365_bc) can be exercised
# end-to-end with no real ERP credential. These are OPERATOR-controlled and
# trusted (they bypass the SSRF guard that polices admin-supplied base URLs).
# Deployed envs leave them unset / default: live Merge.dev, the per-account
# NetSuite URL derived from account_id, and the admin-supplied D365 base_url +
# login.microsoftonline.com token endpoint.
AP_ERP_MERGE_API_BASE=http://localhost:12112/merge/api/accounting/v1
AP_ERP_NETSUITE_API_BASE=http://localhost:12112/netsuite/services/rest/record/v1
AP_ERP_D365_API_BASE=http://localhost:12112/d365
AP_ERP_D365_TOKEN_URL=http://localhost:12112/d365/oauth2/token
